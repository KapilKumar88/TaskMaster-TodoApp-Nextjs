# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskMasterTodoApp?schema=public"

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL="http://localhost:5175"
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Task Master"

# Base URL used in email links (no trailing slash)
APP_URL="http://localhost:5175"

# AES algorithm for encrypting tokens in email links (default: aes-256-cbc)
ENCRYPTION_ALGORITHM=aes-256-cbc

# ─────────────────────────────────────────────
# Redis (BullMQ queue worker)
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────
# Cron
# ─────────────────────────────────────────────
# Bearer token that authenticates calls to /api/cron
CRON_JOB_SECRET=
# Base URL the cron script uses to call the Next.js server
API_BASE_URL="http://localhost:5175"

# ─────────────────────────────────────────────
# Email (Nodemailer SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="TaskMaster <noreply@example.com>"

# ─────────────────────────────────────────────
# Firebase Admin SDK (FCM push notifications — server-side)
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────
# Firebase Client SDK (browser push notifications)
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
